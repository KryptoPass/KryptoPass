<kp:template xmlns:kp="https://kryptopass.org/ns/template/1" id="database" version="1" kind="builtin">
  <kp:meta>
    <kp:name/>
    <kp:icon name="server-database"/>
    <kp:search-title field="title"/>
    <kp:summary field="db-name"/>
  </kp:meta>
  <kp:fields>
    <kp:section id="connection">
      <kp:field id="db-type" type="choice">
        <kp:label/>
        <kp:prop name="options" value="postgresql,mysql,mariadb,sqlite,mongodb,redis,mssql,oracle,other"/>
      </kp:field>
      <kp:field id="host" type="text" copy="true" search="index">
        <kp:label/>
      </kp:field>
      <kp:field id="port" type="number" copy="true">
        <kp:label/>
      </kp:field>
      <kp:field id="db-name" type="text" copy="true" search="index">
        <kp:label/>
      </kp:field>
      <kp:field id="username" type="text" copy="true">
        <kp:label/>
      </kp:field>
      <kp:field id="password" type="secret" copy="true" history="true">
        <kp:label/>
        <kp:generator ref="password"/>
      </kp:field>
      <kp:field id="connection-string" type="secret" copy="true">
        <kp:label/>
      </kp:field>
    </kp:section>
    <kp:section id="extra">
      <kp:field id="notes" type="multiline" format="markdown">
        <kp:label/>
        <kp:limit max-bytes="262144"/>
      </kp:field>
      <kp:custom-fields allowed="true" max="50"/>
    </kp:section>
  </kp:fields>
  <kp:behavior>
    <kp:versions max="20"/>
  </kp:behavior>
</kp:template>
