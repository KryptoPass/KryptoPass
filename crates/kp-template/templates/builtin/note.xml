<kp:template xmlns:kp="https://kryptopass.org/ns/template/1" id="note" version="1" kind="builtin">
  <kp:meta>
    <kp:name/>
    <kp:icon name="view-pim-notes"/>
    <kp:search-title field="title"/>
  </kp:meta>
  <kp:fields>
    <kp:section id="content">
      <kp:field id="body" type="multiline" required="true" format="markdown">
        <kp:label/>
        <kp:limit max-bytes="262144"/>
      </kp:field>
    </kp:section>
  </kp:fields>
</kp:template>
