<kp:template xmlns:kp="https://kryptopass.org/ns/template/1" id="server" version="1" kind="builtin">
  <kp:meta>
    <kp:name/>
    <kp:icon name="network-server"/>
    <kp:search-title field="title"/>
    <kp:summary field="host"/>
  </kp:meta>
  <kp:fields>
    <kp:section id="connection">
      <kp:field id="host" type="text" required="true" copy="true" search="index">
        <kp:label/>
      </kp:field>
      <kp:field id="port" type="number" copy="true">
        <kp:label/>
      </kp:field>
      <kp:field id="username" type="text" copy="true" search="index">
        <kp:label/>
      </kp:field>
      <kp:field id="password" type="secret" copy="true" history="true">
        <kp:label/>
        <kp:generator ref="password"/>
      </kp:field>
      <kp:field id="admin-url" type="url">
        <kp:label/>
      </kp:field>
    </kp:section>
    <kp:section id="extra">
      <kp:field id="notes" type="multiline" format="markdown">
        <kp:label/>
        <kp:limit max-bytes="262144"/>
      </kp:field>
      <kp:custom-fields allowed="true" max="50"/>
    </kp:section>
  </kp:fields>
  <kp:behavior>
    <kp:versions max="20"/>
  </kp:behavior>
</kp:template>
