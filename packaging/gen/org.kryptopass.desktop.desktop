[Desktop Entry]
Type=Application
Name=KryptoPass
GenericName=Credential vault
GenericName[es]=Bóveda de credenciales
Comment=Organize credentials and secure notes with OpenPGP encryption
Comment[es]=Organiza credenciales y notas seguras con cifrado OpenPGP
Exec=kryptopass-desktop %f
Icon=org.kryptopass.desktop
X-DocPath=org.kryptopass.desktop/index.html
Terminal=false
Categories=Qt;KDE;System;Security;
Keywords=password;credentials;vault;OpenPGP;
Keywords[es]=contraseña;credenciales;bóveda;OpenPGP;
MimeType=application/vnd.kryptopass.backup;
StartupNotify=true
SingleMainWindow=true
Actions=NewEntry;Search;

[Desktop Action NewEntry]
Name=New item
Name[es]=Nuevo elemento
Icon=document-new
Exec=kryptopass-desktop --new-entry

[Desktop Action Search]
Name=Search the vault
Name[es]=Buscar en la bóveda
Icon=edit-find
Exec=kryptopass-desktop --search
