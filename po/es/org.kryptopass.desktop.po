msgstr "Selecciona para ver el usuario"

#, kde-format
msgid "Loading username…"
msgstr "Cargando usuario…"

#, kde-format
msgid "The username could not be read"
msgstr "No se pudo leer el usuario"

#, kde-format
msgid "No username"
msgstr "Sin usuario"

#, kde-format
msgid "The browser is requesting a username and password for:"
msgstr "El navegador solicita usuario y contraseña para:"

#, kde-format
msgid "Requested site: %1"
msgstr "Sitio solicitado: %1"

#, kde-format
msgid ""
"Choose a login. It is sent only if it has this same site saved. The "
"authorization covers this request."
msgstr ""
"Elige una credencial. Solo se enviará si tiene guardado este mismo sitio. La "
"autorización sirve para esta solicitud."

#, kde-format
msgctxt "@title:window"
msgid "Connect the Browser"
msgstr "Conectar el navegador"

#, kde-format
msgid ""
"The extension is asking to pair with this vault. Accept only if you just "
"started the connection from your browser.\n"
"\n"
"The pairing is kept when KryptoPass restarts. Every fill request will "
"require your authorization."
msgstr ""
"La extensión solicita vincularse con esta bóveda. Acepta solo si acabas de "
"iniciar la conexión desde tu navegador.\n"
"\n"
"La vinculación se conservará al reiniciar KryptoPass. Cada solicitud de "
"relleno requerirá tu autorización."

#, kde-format
msgctxt "@action:button"
msgid "Reject Connection"
msgstr "Rechazar conexión"

#, kde-format
msgctxt "@action:button"
msgid "Pair Browser"
msgstr "Vincular navegador"

