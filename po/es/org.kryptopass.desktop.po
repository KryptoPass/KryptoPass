msgctxt "@title:window"
msgid "Choose Contact to Link"
msgstr "Elegir contacto para vincular"

#, kde-format
msgid "Select a contact from KDE Contacts to add this OpenPGP fingerprint to."
msgstr ""
"Selecciona un contacto de KDE Contacts para añadirle esta huella OpenPGP."

